{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkin-system",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    // /__scheduled 只在 `wrangler dev --test-scheduled` 有作用，讓本機能手動觸發排程
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkin-db",
      "database_id": "06afc38e-9355-47e2-b280-09c80922e05a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [{ "pattern": "checkin.junwei.me", "custom_domain": true }]
}
